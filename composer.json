{
    "name": "gateform/yii3",
    "description": "Интеграция GateForm с Yii3: виджеты формы, отзывов и связи, валидатор токена и PSR-15 middleware.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "yii3",
        "gateform",
        "captcha",
        "spam",
        "form-protection",
        "reviews",
        "widget",
        "psr-15"
    ],
    "homepage": "https://gateform.ru",
    "authors": [
        {
            "name": "GateForm",
            "homepage": "https://gateform.ru"
        }
    ],
    "support": {
        "issues": "https://github.com/RuGate-Form/gateform-yii3/issues",
        "source": "https://github.com/RuGate-Form/gateform-yii3"
    },
    "require": {
        "php": ">=8.1",
        "gateform/sdk": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "suggest": {
        "yiisoft/validator": "Для проверки атрибутов моделей через TokenValidator",
        "yiisoft/yii-view": "Для рендеринга виджетов в представлениях Yii3",
        "yiisoft/di": "Для регистрации TokenValidator и middleware в контейнере"
    },
    "autoload": {
        "psr-4": {
            "GateForm\\Yii3\\": "src/"
        }
    },
    "scripts": {
        "lint": "php tests/lint.php"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
